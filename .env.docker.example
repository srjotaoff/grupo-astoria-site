PORT_ADMIN=3001
PORT_CHOCOSUL=3002
PORT_MASTTER=3003

# Update to your public frontend domains
ALLOWED_ORIGIN=http://chocosul.local

# Keep APP_NAME empty in docker services (compose controls it)
APP_NAME=

# Database connection used by Admin/Chocosul API
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USER=seu_usuario_mysql
DB_PASSWORD=sua_senha_mysql
DB_NAME=seu_banco_dados

# Replace with a strong secret in production
JWT_SECRET=troque_esse_valor

